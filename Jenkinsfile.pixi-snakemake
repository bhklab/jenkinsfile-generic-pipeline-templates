@Library('orcestra-lib') _

boolean useLargeMachine = params.LARGE_MACHINE_USE as boolean

String nodeRole = useLargeMachine ? 'snakemake-exec-big' : 'snakemake-exec-small'
String cpuRequest = useLargeMachine ? '7' : '3'
String cpuLimit = useLargeMachine ? '8' : '4'

String memoryRequest = useLargeMachine ? '24Gi' : '13Gi'
String memoryLimit = useLargeMachine ? '30Gi' : '15Gi'

String ephermeralRequest = '130Gi' // Both machine types can have the same ephemeral storage request
String ephermeralLimit = '190Gi' // Both machine types can have the same ephemeral storage limit

pipeline {
  options {
    timeout(time: 6, unit: 'HOURS')
  }

  agent {
    kubernetes {
      cloud 'gke-snakemake'
      podRetention never()
      activeDeadlineSeconds 21600
      yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    app: jenkins-agent
    workload: snakemake
  annotations:
    orcestra/pipeline-name: "${params.PIPELINE_NAME}"
    orcestra/run-id: "${params.RUN_ID}"
spec:
  serviceAccountName: jenkins-agent-runner
  nodeSelector:
    role: ${nodeRole}
  tolerations:
  - key: "workload"
    operator: "Equal"
    value: "snakemake"
    effect: "NoSchedule"
  containers:
  - name: pixi
    image: nickmess08/pixi-snakemake-agent:linux-amd64
    imagePullPolicy: Always
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: ${cpuRequest}
        memory: ${memoryRequest}
        ephemeral-storage: ${ephermeralRequest}
      limits:
        cpu: ${cpuLimit}
        memory: ${memoryLimit}
        ephemeral-storage: ${ephermeralLimit}
"""
    }
  }

  parameters {
    string(name: 'PIPELINE_NAME')
    string(name: 'RUN_ID')
    string(name: 'REPO_URL')

    string(name: 'COMMIT_ID', defaultValue: '')
    string(name: 'BRANCH', defaultValue: '')
    string(name: 'EMAIL', defaultValue: '')

    text(name: 'OUTPUT_DIRECTORIES_JSON', defaultValue: '[]')

    string(name: 'SNAKEFILE_PATH', defaultValue: 'Snakefile')
    string(name: 'CONFIG_FILE_PATH', defaultValue: 'config/config.yaml')

    text(name: 'PIPELINE_RUN_COMMAND', defaultValue: '')
    text(name: 'QC_COMMAND', defaultValue: '')
    string(name: 'QC_OUTPUT_DIRECTORY', defaultValue: '')
    booleanParam(name: 'LARGE_MACHINE_USE', defaultValue: false, description: 'Use the larger GKE burst node pool')
  }

  stages {
    stage('Run Pixi/Snakemake workflow') {
      steps {
        script {
          runPixiSnakemakePipeline(
            containerName: 'pixi',
            gcsBucket: 'gs://nicholas-testing'
          )
        }
      }
    }
  }

  post {
    success {
      script {
        notifyStageSafe(stage: 'Pipeline', status: 'succeeded')
      }
    }

  aborted {
    script {
      String abortedStage = env.CURRENT_PIPELINE_STAGE ?: 'Pipeline'
      notifyStageSafe(
        stage: abortedStage,
        status: 'aborted',
        message: "Pipeline aborted during stage: ${abortedStage}"
      )
    }
  }

    always {
      archiveArtifacts(
        artifacts: '''
          repo/.snakemake/log/**/*.log,
          repo/logs/**/*.log,
          repo/resources/*.svg,
          repo/qc/**/*,
          repo/**/qc/**/*,
          repo/**/*.html,
          repo/**/*.tsv,
          repo/**/*.csv
        ''',
        allowEmptyArchive: true,
        fingerprint: true
      )
    }
  }
}