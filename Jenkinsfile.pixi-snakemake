@Library('orcestra-lib') _

def notifyStageSafe(Map args = [:]) {
  try {
    notifyStage(args)
  } catch (notifyErr) {
    echo "WARNING: Failed to send stage notification: ${notifyErr}"
  }
}

def runStageWithNotification(String stageName, Closure body) {
  notifyStageSafe(stage: stageName, status: 'running')

  try {
    body()
    notifyStageSafe(stage: stageName, status: 'succeeded')
  } catch (err) {
    notifyStageSafe(stage: stageName, status: 'failed', message: err.toString())
    throw err
  }
}

pipeline {
  options {
    timeout(time: 6, unit: 'HOURS')
  }

  agent {
    kubernetes {
      cloud 'gke-snakemake'
      podRetention never()
      activeDeadlineSeconds 21600
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-agent-runner
  nodeSelector:
    role: snakemake-exec-big
  tolerations:
  - key: "workload"
    operator: "Equal"
    value: "snakemake"
    effect: "NoSchedule"
  containers:
  - name: pixi
    image: nickmess08/pixi-snakemake-agent:linux-amd64
    imagePullPolicy: Always
    command: ["cat"]
    tty: true
    resources:
      requests:
        cpu: "4"
        memory: "24Gi"
        ephemeral-storage: "50Gi"
      limits:
        cpu: "4"
        memory: "32Gi"
        ephemeral-storage: "90Gi"
"""
    }
  }

  parameters {
    string(name: 'PIPELINE_NAME')
    string(name: 'RUN_ID')
    string(name: 'REPO_URL')

    string(name: 'COMMIT_ID', defaultValue: '')
    string(name: 'BRANCH', defaultValue: '')
    string(name: 'EMAIL', defaultValue: '')

    text(name: 'OUTPUT_DIRECTORIES_JSON', defaultValue: '[]')

    string(name: 'SNAKEFILE_PATH', defaultValue: 'Snakefile')
    string(name: 'CONFIG_FILE_PATH', defaultValue: 'config/config.yaml')

    text(name: 'PIPELINE_RUN_COMMAND', defaultValue: '')
    text(name: 'QC_COMMAND', defaultValue: '')
    string(name: 'QC_OUTPUT_DIRECTORY', defaultValue: '')
  }

  stages {
    stage('Checkout') {
      steps {
        container('pixi') {
          script {
            runStageWithNotification('Checkout') {
              sh '''#!/usr/bin/env bash
set -euo pipefail

if [ -n "${BRANCH}" ]; then
  git clone --branch "${BRANCH}" "${REPO_URL}" repo
else
  git clone "${REPO_URL}" repo
fi

cd repo

if [ -n "${COMMIT_ID}" ]; then
  git checkout "${COMMIT_ID}"
fi

echo "Checked out repository:"
git rev-parse HEAD
'''
            }
          }
        }
      }
    }

    stage('Install Pixi Environment') {
      steps {
        container('pixi') {
          script {
            runStageWithNotification('Install Pixi Environment') {
              sh '''#!/usr/bin/env bash
set -euo pipefail

cd repo
pixi install --locked || pixi install
'''
            }
          }
        }
      }
    }

    stage('Dry Run') {
      steps {
        container('pixi') {
          script {
            runStageWithNotification('Dry Run') {
              sh '''#!/usr/bin/env bash
set -euo pipefail

cd repo

pixi run snakemake \
  -c 4 \
  --dryrun \
  --snakefile "${SNAKEFILE_PATH}" \
  --configfile "${CONFIG_FILE_PATH}" \
  --printshellcmds
'''
            }
          }
        }
      }
    }

    stage('Run Pipeline') {
      steps {
        container('pixi') {
          script {
            runStageWithNotification('Run Pipeline') {
              sh '''#!/usr/bin/env bash
set -euo pipefail

cd repo

if [ -n "${PIPELINE_RUN_COMMAND}" ]; then
  echo "Running custom pipeline command:"
  echo "${PIPELINE_RUN_COMMAND}"
  eval "${PIPELINE_RUN_COMMAND}"
else
  echo "Running default Snakemake command"

  pixi run snakemake \
    -c 4 \
    --snakefile "${SNAKEFILE_PATH}" \
    --configfile "${CONFIG_FILE_PATH}" \
    --printshellcmds \
    --show-failed-logs \
    --rerun-incomplete
fi
'''
            }
          }
        }
      }
    }

    stage('Run QC') {
      when {
        expression {
          return params.QC_COMMAND?.trim()
        }
      }
      steps {
        container('pixi') {
          script {
            runStageWithNotification('Run QC') {
              sh '''#!/usr/bin/env bash
set -euo pipefail

cd repo

echo "Running QC command:"
echo "${QC_COMMAND}"

eval "${QC_COMMAND}"
'''
            }
          }
        }
      }
    }

    stage('Upload outputs to GCS') {
      steps {
        container('pixi') {
          script {
            runStageWithNotification('Upload outputs to GCS') {
              sh '''#!/usr/bin/env bash
set -euo pipefail

cd repo

echo "Output directories JSON:"
echo "${OUTPUT_DIRECTORIES_JSON}"

python - <<'PY' > /tmp/output_dirs.txt
import json
import os

raw = os.environ.get("OUTPUT_DIRECTORIES_JSON", "[]")
dirs = json.loads(raw)

if not isinstance(dirs, list):
    raise ValueError("OUTPUT_DIRECTORIES_JSON must be a JSON list")

for directory in dirs:
    if not isinstance(directory, str):
        raise ValueError("Each output directory must be a string")
    directory = directory.strip()
    if directory:
        print(directory)
PY

if [ ! -s /tmp/output_dirs.txt ]; then
  echo "No output directories were provided in OUTPUT_DIRECTORIES_JSON"
  exit 1
fi

while IFS= read -r output_dir; do
  [ -z "$output_dir" ] && continue

  echo "Checking output directory: ${output_dir}"

  if [ ! -d "$output_dir" ]; then
    echo "Output directory does not exist: ${output_dir}"
    exit 1
  fi

  echo "Uploading ${output_dir} to gs://nicholas-testing/pipelines/${PIPELINE_NAME}/${RUN_ID}/${output_dir}/"

  gcloud storage cp \
    --recursive \
    "$output_dir" \
    "gs://nicholas-testing/pipelines/${PIPELINE_NAME}/${RUN_ID}/${output_dir}/"

done < /tmp/output_dirs.txt

if [ -n "${QC_OUTPUT_DIRECTORY}" ] && [ -d "${QC_OUTPUT_DIRECTORY}" ]; then
  echo "Uploading QC output directory: ${QC_OUTPUT_DIRECTORY}"

  gcloud storage cp \
    --recursive \
    "${QC_OUTPUT_DIRECTORY}" \
    "gs://nicholas-testing/pipelines/${PIPELINE_NAME}/${RUN_ID}/${QC_OUTPUT_DIRECTORY}/"
fi
'''
            }
          }
        }
      }
    }
  }

  post {
    success {
      script {
        notifyStageSafe(stage: 'Pipeline', status: 'succeeded')
      }
    }

    aborted {
      script {
        notifyStageSafe(stage: 'Pipeline', status: 'aborted', message: 'Pipeline aborted')
      }
    }

    always {
      archiveArtifacts(
        artifacts: '''
          repo/.snakemake/log/**/*.log,
          repo/logs/**/*.log,
          repo/resources/*.svg,
          repo/qc/**/*,
          repo/**/qc/**/*,
          repo/**/*.html,
          repo/**/*.tsv,
          repo/**/*.csv
        ''',
        allowEmptyArchive: true,
        fingerprint: true
      )
    }
  }
}